# NestJS server
PORT=4000
FRONTEND_URL=http://localhost:3000

# OpenAI (backend only; never expose this through NEXT_PUBLIC_*)
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-5.4

# OpenAI web search grounding for current football questions
LIVE_SEARCH_ENABLED=true
# Optional: defaults to AI_MODEL
LIVE_SEARCH_MODEL=gpt-5.4
